{
  "mcpServers": {
    "model-migrate": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"],
      "env": {
        "CLAUDE_PLUGIN_OPTION_OPENAI_API_KEY": "${user_config.openai_api_key}",
        "CLAUDE_PLUGIN_OPTION_ANTHROPIC_API_KEY": "${user_config.anthropic_api_key}",
        "CLAUDE_PLUGIN_OPTION_GEMINI_API_KEY": "${user_config.gemini_api_key}"
      }
    }
  }
}
