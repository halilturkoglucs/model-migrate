{
  "mcpServers": {
    "model-migrate": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"],
      "env": {
        "MODEL_MIGRATE_OPENAI_KEY": "${user_config.openai_api_key}",
        "MODEL_MIGRATE_ANTHROPIC_KEY": "${user_config.anthropic_api_key}",
        "MODEL_MIGRATE_GEMINI_KEY": "${user_config.gemini_api_key}"
      }
    }
  }
}
