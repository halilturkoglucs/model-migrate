#!/usr/bin/env node
import path from "node:path"
import { buildStatus, kindCounts } from "../lib/report.mjs"
import { scanDirectory, uniqueModels } from "../lib/scan.mjs"

const HELP = `model-migrate <command>

  scan [dir] [--json]    Find AI model IDs in a codebase
  status [dir] [--json] [--within DAYS] [--fail]
                         Check public shutdown dates (default 90 days)
                         --fail exits 1 for retired or urgent models used
                         outside tests and docs, or if a source cannot be read

This CLI uses no API keys. Paid model comparison runs through the plugin's MCP tools.
`

const args = process.argv.slice(2)
const command = args[0]
const flag = name => args.includes(name)
function option(name) {
  const index = args.indexOf(name)
  return index >= 0 ? args[index + 1] : undefined
}
function firstPositional() {
  return args.slice(1).find((arg, index, list) => !arg.startsWith("--") && list[index - 1] !== "--within")
}
const print = text => process.stdout.write(`${text}\n`)
function table(headers, rows) {
  const line = cells => `| ${cells.join(" | ")} |`
  return [line(headers), line(headers.map(() => "---")), ...rows.map(row => line(row.map(cell => String(cell))))].join("\n")
}

async function scan() {
  const root = path.resolve(firstPositional() || ".")
  const result = await scanDirectory(root)
  if (flag("--json")) return print(JSON.stringify(result, null, 2))
  const models = uniqueModels(result.usages)
  print(table(["Model", "Provider", "Used in"], models.map(item => [item.model, item.provider, kindCounts(item.usages)])))
  print("\nUsages")
  for (const usage of result.usages) {
    const tags = [usage.kind, usage.envOverride && "env-override", usage.costBranch ? "cost-branch" : usage.branch && "branch"].filter(Boolean).join(", ")
    print(`${usage.file}:${usage.line} ${usage.model} [${tags}]`)
  }
  print("\nAPI surface per file")
  for (const [file, surface] of Object.entries(result.files)) {
    if (surface.endpoints.length || surface.parameters.length) print(`${file}: endpoints=${surface.endpoints.join(",") || "-"} params=${surface.parameters.join(",") || "-"}`)
  }
}

async function status() {
  const report = await buildStatus(path.resolve(firstPositional() || "."), { withinDays: Number(option("--within") ?? 90) })
  if (flag("--json")) print(JSON.stringify(report, null, 2))
  else {
    print(table(["State", "Model", "Date", "Listed replacement", "Used in", "Basis"], report.models.map(row =>
      [row.state, row.model, row.date ? `${row.approximate ? "not before " : ""}${row.date}` : "-", row.replacement ?? "-", row.usedIn, row.basis])))
    print("\nno-date means no shutdown was found. It does not guarantee the model is safe.")
    for (const error of report.sourceErrors) print(`SOURCE ERROR: ${error}`)
  }
  if (flag("--fail") && (report.failing.length || report.sourceErrors.length)) process.exitCode = 1
}

const commands = { scan, status }
if (!commands[command]) {
  print(HELP)
  process.exitCode = command && !["help", "--help", "-h"].includes(command) ? 2 : 0
} else {
  commands[command]().catch(error => {
    process.stderr.write(`model-migrate: ${error.message}\n`)
    process.exitCode = 1
  })
}
